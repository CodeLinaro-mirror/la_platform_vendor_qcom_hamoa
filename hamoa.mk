TARGET_KERNEL_DLKM_SECUREMSM_QTEE_OVERRIDE := true
TARGET_KERNEL_DLKM_LIMITS_OVERRIDE := false
TARGET_KERNEL_DLKM_TOUCH_OVERRIDE := false
TARGET_KERNEL_DLKM_VIDEO_OVERRIDE := false
