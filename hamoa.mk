TARGET_KERNEL_DLKM_MMRM_OVERRIDE := false
TARGET_KERNEL_DLKM_DATARMNET_OVERRIDE := false
TARGET_KERNEL_DLKM_DATARMNETEXT_OVERRIDE := false
